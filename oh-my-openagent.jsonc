  "background_task": {
    "providerConcurrency": {
      "anthropic": 2, // $500 YC credits — now usable, not emergency-only
      "openai": 4, // $2,500 YC credits — now more liberal
      "google": 8, // Covered by AI Pro quota
      "deepseek": 12, // Cheap; parallelize freely
      "kimi": 4, // Rate limits by tier
      "zhipu": 10, // GLM flash is free
      "qwen": 8, // Via OpenRouter
      "xai": 8, // $2,500 YC Grok credits; grok-4.1-fast is main workhorse
    },
    "modelConcurrency": {
      // ← normalized all keys to "provider/model" format
      "anthropic/claude-sonnet-4-5": 2,
      "anthropic/claude-sonnet-4-6": 2,
      "openai/o3": 1,
      "openai/gpt-5.4": 1,

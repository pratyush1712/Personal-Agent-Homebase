{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-openagent.schema.json",
  "_meta": {
    "author": "Pratyush Sudhakar",
    "updated": "2026-04-25",
    "version": "3.1.0",

    // ─── COST HIERARCHY ────────────────────────────────────────────────────────
    //
    // TIER 0 — SUBSCRIPTION / FREE (zero marginal cost per request)
    //   cursor-acp/*          Cursor Pro Plus ($60/mo flat) — Claude Opus 4.6,
    //                         GPT-5.1 Codex Max, Gemini 3 Pro Preview, Grok Code
    //                         Fast, Claude Sonnet 4.5/4.6, GPT-5.1 High, DeepSeek v3.
    //                         USE FIRST for all interactive & agent coding tasks.
    //   glm-4.7-flash         Z.ai free forever, 203K ctx
    //   glm-4.5-flash         Z.ai free forever
    //
    // TIER 1 — QUOTA (Google AI Pro $19.99/mo — ~zero marginal cost)
    //   gemini-3-flash        Within monthly quota
    //   gemini-3.1-pro        Within monthly quota
    //
    // TIER 2 — ULTRA-CHEAP PAID
    //   grok-4.1-fast         $0.20/$0.50/M — primary headless workhorse, 2M ctx
    //                         Backed by $2,500 YC Grok credits ≈ 5B output tokens
    //                         ALSO: opt in to xAI data sharing → +$150/mo FREE
    //                         (console.x.ai → Settings → Data Sharing)
    //   deepseek-v4           $0.30/$0.50/M — 81% SWE-bench, 90% cache discount
    //   gpt-4.1-nano          $0.10/$0.40/M — backed by $2,500 YC OpenAI credits
    //   qwen3-30b-a3b         ~$0.08/M input via OpenRouter
    //   glm-4.7               $0.39/$1.75/M paid GLM tier
    //
    // TIER 3 — MID PAID
    //   grok-3-mini           $0.30/$0.50/M — reasoning model
    //   deepseek-r1           $0.55/$2.19/M — cheapest pure CoT reasoning
    //   kimi-k2.5             $0.60/$2.50/M — 256K ctx, docs/summarization
    //   gpt-4.1-mini          $0.40/$1.60/M
    //   qwen2.5-coder-32b     $0.66/$0.80/M specialized coder
    //
    // TIER 4 — PREMIUM PAID (now accessible via YC credits)
    //   grok-4                $3/$15/M — via $2,500 YC Grok credits
    //   o4-mini               $1.10/$4.40/M — via $2,500 YC OpenAI credits
    //   claude-sonnet (API)   $3/$15/M — via $500 YC Anthropic credits
    //   gemini-2.5-pro        Paid fallback after Google quota exhaustion
    //
    // TIER 5 — LAST RESORT
    //   o3                    $2/$8/M — council + hardest problems only
    //   gpt-5.4               $2.50/$15/M — burn premium budget sparingly
    //   claude-opus-vertex    Via GCP Vertex AI (billed to GCP, not Anthropic)
    //
    // ─── CURSOR-ACP SETUP ──────────────────────────────────────────────────────
    // Install opencode-cursor-oauth plugin:
    //   npm install -g opencode-cursor-oauth
    //   Add to ~/.config/opencode/opencode.json:
    //     "plugin": ["opencode-cursor-oauth"],
    //     "provider": { "cursor": { "name": "Cursor" } }
    //   Then: opencode auth login --provider cursor
    //
    // Available cursor-acp models (Cursor Pro Plus):
    //   cursor-acp/auto                  Cursor's smart routing (recommended)
    //   cursor-acp/claude-opus-4-6       Architecture, hard code review, 1M ctx
    //   cursor-acp/claude-sonnet-4-5     Workhorse coding, 77.2% SWE-bench
    //   cursor-acp/gpt-5.1-codex-max     Pure code generation specialist
    //   cursor-acp/gemini-3-pro-preview  Multimodal review, design critique
    //   cursor-acp/grok-code-fast        Fast coding, X/web search access
    //   cursor-acp/gpt-5.1-high          Reasoning + coding balance
    //   cursor-acp/gpt-5-mini            Cheap + fast for simple Cursor tasks
    //
    // cursor-acp/* models do NOT go through LiteLLM at localhost:4000.
    // All other models use the LiteLLM proxy.
    //
    // ─── YC AI STACK CREDITS SUMMARY ──────────────────────────────────────────
    // OpenAI    $2,500 → gpt-4.1-nano/mini (vast budget); o4-mini/o3 when needed
    // Grok xAI  $2,500 → grok-4.1-fast ($0.50/M output) ≈ 5B output tokens
    //                      +$150/mo FREE via data sharing (opt in at console.x.ai)
    // Anthropic $500   → Claude API credits (~33K output at Sonnet $15/M)
    //                      Use cursor-acp for Claude to preserve API credits
    // Cursor    $720   → Annual Pro Plus purchased for ~$622 (tax included).
    //                    $97 remaining credits (save for renewal in 12 months).
    //                    Annual plan: subscription locked for 1 year, usage resets monthly.
    //                    No monthly billing anxiety — parallelize cursor-acp/* freely.
    // AWS       $10,000 → Host entire openagent-stack
    //
    "proxy": "localhost:4000 via LiteLLM (for all non-cursor-acp models)",
    "litellm_config": "./config/litellm/litellm.config.yaml", // ← fixed path
  },

  "agents": {
    // ── ORCHESTRATOR ──────────────────────────────────────────────────────────
    "sisyphus": {
      "_role": "ORCHESTRATOR — task decomposition, delegation, token budget tracking",
      "model": "cursor-acp/claude-opus-4-6",
      "temperature": 0.3,
      "maxTokens": 16000, // ← was 8192; orchestration output needs room for full graphs
      "system_prompt_append": "\n\n<role>You are the top-level orchestrator. Before delegating, emit: (1) numbered subtask list, (2) estimated token budget per subtask, (3) agent type per step, (4) dependency graph, (5) risk flags. Keep system prompts stable across calls to maximize cache hits on non-Cursor providers.</role>\n\n<skills>Backend: .agents/architecture/backend-architect.md | Mobile: .agents/architecture/react-native-architecture.md | Tooling: .agents/tooling/using-superpowers.md</skills>",
      "fallback_models": [
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
        "http://localhost:4000/v1||gemini-3-flash||sk-litellm-master",
        "http://localhost:4000/v1||deepseek-v4||sk-litellm-master",
        "http://localhost:4000/v1||gpt-4.1-mini||sk-litellm-master",
        "http://localhost:4000/v1||glm-4.7-flash||sk-litellm-master", // ← added: free-tier last resort
      ],
    },

    // ── PLANNER ───────────────────────────────────────────────────────────────
    "prometheus": {
      "_role": "PLANNER — architecture design, implementation roadmaps, risk analysis",
      "model": "cursor-acp/claude-sonnet-4-5",
      "temperature": 0.2,
      "maxTokens": 16000, // ← was 12000; standardized
      "system_prompt_append": "\n\n<role>You are the planning specialist. Emit: (1) numbered steps with token-budget estimates, (2) agent type per step, (3) dependency graph, (4) risk/failure-mode flags. Surface ambiguities before proceeding. Prefer explicit over implicit.</role>\n\n<skills>Backend/DB: .agents/architecture/backend-architect.md | Mobile: .agents/architecture/react-native-architecture.md</skills>",
      "fallback_models": [
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
        "http://localhost:4000/v1||deepseek-v4||sk-litellm-master",
        "http://localhost:4000/v1||deepseek-r1||sk-litellm-master",
        "http://localhost:4000/v1||o4-mini||sk-litellm-master",
      ],
    },

    // ── PRIMARY CODER ─────────────────────────────────────────────────────────
    // GPT-5.1 Codex Max via Cursor = code-specialist model at subscription rate.
    // Falls to Claude Sonnet (also Cursor), then grok-4.1-fast as cheapest
    // capable headless fallback ($0.20/$0.50, backed by $2,500 YC credits).
    "atlas": {
      "_role": "CODER — primary implementation, feature development, bug fixes",
      "model": "cursor-acp/gpt-5.1-codex-max",
      "temperature": 0.15,
      "maxTokens": 16000,
      "system_prompt_append": "\n\n<role>You are the primary coding agent. Prefer small composable functions, strong TypeScript types, and explicit error handling. Never silently swallow errors. Write self-documenting code; comments only for non-obvious logic.</role>\n\n<skills>FastAPI/Python: .agents/sdks/fastapi.md + sqlalchemy.md | Expo/RN: .agents/sdks/expo.md + tamagui.md | Next.js: .agents/sdks/tanstack.md + shadcn.md | All TS: .agents/language/typescript.md | Mobile UI: .agents/ui-ux/mobile-design.md</skills>",
      "fallback_models": [
        "cursor-acp/claude-sonnet-4-5",
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
        "http://localhost:4000/v1||gemini-3-flash||sk-litellm-master",
        "http://localhost:4000/v1||deepseek-v4||sk-litellm-master",
        "http://localhost:4000/v1||qwen3-30b-a3b||sk-litellm-master",
        "http://localhost:4000/v1||gpt-4.1-mini||sk-litellm-master",
      ],
    },

    // ── MOBILE CODER (Expo / React Native / Tamagui — Playspace) ─────────────
    // Sonnet 4.5 handles 95%+ of routine RN/Tamagui work.
    // Opus (1M ctx) fires for full-codebase sessions via fallback — intentional.
    "hephaestus": {
      "_role": "MOBILE CODER — Expo/React Native/Tamagui specialist (Playspace app)",
      "model": "cursor-acp/claude-sonnet-4-5", // ← was claude-opus-4-6; Sonnet for routine work
      "temperature": 0.15,
      "maxTokens": 16000,
      "system_prompt_append": "\n\n<role>You are the Expo/React Native specialist. Always use Tamagui primitives (XStack/YStack/Text/styled). Prefer useResponsiveLayout and useDesignSystem hooks. Write for phone AND tablet (responsive). Avoid StyleSheet.create. Test component logic mentally against iOS and Android before outputting.</role>\n\n<skills>.agents/sdks/expo.md + .agents/sdks/tamagui.md + .agents/ui-ux/mobile-design.md + .agents/sdks/tanstack.md</skills>",
      "fallback_models": [
        "cursor-acp/claude-opus-4-6", // ← Opus as first fallback; fires for full-codebase scope
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
        "http://localhost:4000/v1||deepseek-v4||sk-litellm-master",
        "http://localhost:4000/v1||qwen2.5-coder-32b||sk-litellm-master",
        "http://localhost:4000/v1||gpt-4.1-mini||sk-litellm-master",
      ],
    },

    // ── REVIEWER / AUDITOR ────────────────────────────────────────────────────
    // Claude Opus 4.6 via Cursor: 1M context holds entire codebase for deep
    // security/architecture audit. Gemini falls back for multimodal PR reviews.
    "oracle": {
      "_role": "REVIEWER — code review, security audit, architecture critique",
      "model": "cursor-acp/claude-opus-4-6", // ← was gemini-3-pro-preview; Opus for code depth
      "temperature": 0.1,
      "maxTokens": 8192,
      "system_prompt_append": "\n\n<role>Rate every finding: CRITICAL / MAJOR / MINOR / NIT. Code: type safety, error handling, performance, security (injection, auth, data exposure). Architecture: coupling, SOLID violations, scaling failure modes. Never skip CRITICAL items.</role>\n\n<skills>Code: .agents/language/typescript.md | Backend: .agents/architecture/backend-architect.md | DB: .agents/sdks/sqlalchemy.md</skills>",
      "fallback_models": [
        "http://localhost:4000/v1||gemini-3.1-pro||sk-litellm-master", // multimodal PR fallback
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
        "http://localhost:4000/v1||gemini-2.5-pro||sk-litellm-master",
        "http://localhost:4000/v1||kimi-k2.5||sk-litellm-master",
        "http://localhost:4000/v1||o4-mini||sk-litellm-master",
      ],
    },

    // ── REFACTOR ──────────────────────────────────────────────────────────────
    // Grok 4.1 Fast: safe minimal diffs at $0.20/$0.50/M.
    "metis": {
      "_role": "REFACTOR — safe minimal diffs, localized changes, incremental improvements",
      "model": "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
      "temperature": 0.2,
      "maxTokens": 8192,
      "system_prompt_append": "\n\n<role>Focus on safe, minimal diffs. Explain any non-trivial change in a comment. Keep changes localized. Prefer pure functions over side effects.</role>",
      "fallback_models": [
        "http://localhost:4000/v1||deepseek-v4||sk-litellm-master",
        "http://localhost:4000/v1||qwen3-30b-a3b||sk-litellm-master",
        "http://localhost:4000/v1||gpt-4.1-mini||sk-litellm-master",
        "http://localhost:4000/v1||glm-4.7||sk-litellm-master",
      ],
    },

    // ── BOILERPLATE / SCAFFOLDING ─────────────────────────────────────────────
    "metis_lite": {
      "_role": "BOILERPLATE — scaffolding, CRUD generation, template/schema fills",
      "model": "http://localhost:4000/v1||gpt-4.1-nano||sk-litellm-master",
      "temperature": 0.2,
      "maxTokens": 8192,
      "system_prompt_append": "\n\n<role>Generate idiomatic boilerplate fast. Match patterns in the relevant SDK skill file. Emit complete files, not partial snippets, unless told otherwise.</role>\n\n<skills>Load the matching .agents/sdks/ skill before generating.</skills>",
      "fallback_models": [
        "http://localhost:4000/v1||glm-4.7-flash||sk-litellm-master",
        "http://localhost:4000/v1||qwen3-30b-a3b||sk-litellm-master",
        "http://localhost:4000/v1||glm-4.7||sk-litellm-master",
      ],
    },

    // ── RESEARCHER ────────────────────────────────────────────────────────────
    // Grok 4.1 Fast: built-in web/X search is a structural research advantage.
    "librarian": {
      "_role": "RESEARCHER — web search, documentation lookup, context gathering",
      "_note": "Grok's built-in web/X search is a unique research advantage",
      "model": "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
      "temperature": 0.4,
      "maxTokens": 8192,
      "system_prompt_append": "\n\n<role>Always cite file paths or URLs. Summarize as structured markdown. Flag any source older than 6 months. Verify library versions against current docs. Use built-in web search when available.</role>\n\n<skills>.agents/tooling/browser-use.md</skills>",
      "fallback_models": [
        "http://localhost:4000/v1||gemini-3-flash||sk-litellm-master",
        "http://localhost:4000/v1||deepseek-v4||sk-litellm-master",
        "http://localhost:4000/v1||glm-4.7||sk-litellm-master",
      ],
    },

    // ── DOCUMENTER ────────────────────────────────────────────────────────────
    // Kimi K2.5: 256K context + 75% auto-cache discount.
    "hermes": {
      "_role": "DOCUMENTER — READMEs, TSDoc/JSDoc, changelogs, OpenAPI 3.1 specs",
      "model": "http://localhost:4000/v1||kimi-k2.5||sk-litellm-master",
      "temperature": 0.3,
      "maxTokens": 16000,
      "system_prompt_append": "\n\n<role>Write GitHub-flavored Markdown for prose docs. TSDoc/JSDoc for code. OpenAPI 3.1 for API specs. Concise and scannable — use headers, tables, code blocks.</role>\n\n<skills>.agents/tooling/document-handling.md</skills>",
      "fallback_models": [
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
        "http://localhost:4000/v1||deepseek-v4||sk-litellm-master",
        "http://localhost:4000/v1||gemini-3-flash||sk-litellm-master",
      ],
    },

    // ── SUMMARIZER ────────────────────────────────────────────────────────────
    "mnemosyne": {
      "_role": "SUMMARIZER — compress large codebases, long threads, large documents",
      "_note": "Kimi K2.5: 256K context + 75% auto-cache discount",
      "model": "http://localhost:4000/v1||kimi-k2.5||sk-litellm-master",
      "temperature": 0.2,
      "maxTokens": 16000, // ← was 32000; capped to avoid quota exhaustion on long runs
      "fallback_models": [
        "http://localhost:4000/v1||kimi-k2.6||sk-litellm-master",
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master", // 2M ctx good for codebase-scale
        "http://localhost:4000/v1||gemini-3.1-pro||sk-litellm-master",
      ],
    },

    // ── REASONER ──────────────────────────────────────────────────────────────
    // DeepSeek R1 first (cheapest pure CoT). Grok 3 Mini as secondary (same
    // output price but better English instruction following). Then o4-mini.
    "delphi": {
      "_role": "REASONER — deep multi-step reasoning, algorithm design, complex debugging",
      "model": "http://localhost:4000/v1||deepseek-r1||sk-litellm-master",
      "temperature": 0.1,
      "maxTokens": 16000,
      "system_prompt_append": "\n\n<role>Think step by step. Show reasoning chain explicitly. For code: explain algorithm before writing. For architecture: enumerate tradeoffs and failure modes before recommending. Prefer correctness over speed.</role>",
      "fallback_models": [
        "http://localhost:4000/v1||grok-3-mini||sk-litellm-master",
        "http://localhost:4000/v1||o4-mini||sk-litellm-master",
        "http://localhost:4000/v1||kimi-k2.5||sk-litellm-master",
        "http://localhost:4000/v1||o3||sk-litellm-master",
      ],
    },

    // ── CRITIC ────────────────────────────────────────────────────────────────
    // GLM-4.7-Flash is FREE — devil's advocate brainstorming needs volume, not cost.
    "momus": {
      "_role": "CRITIC — devil's advocate, challenge assumptions, pre-mortem analysis",
      "model": "http://localhost:4000/v1||glm-4.7-flash||sk-litellm-master", // ← was glm-4.7 (paid); free is fine for critic
      "temperature": 0.7,
      "maxTokens": 4096,
      "system_prompt_append": "\n\n<role>Your job is to find problems. For every proposed design: (1) what breaks at scale, (2) what assumptions could be wrong, (3) second-order effects. Output as numbered challenges.</role>",
      "fallback_models": [
        "http://localhost:4000/v1||glm-4.7||sk-litellm-master", // paid GLM if flash is rate-limited
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
        "http://localhost:4000/v1||gpt-4.1-mini||sk-litellm-master",
      ],
    },

    // ── QUICK / INTERACTIVE ───────────────────────────────────────────────────
    "explorer": {
      "_role": "QUICK — fast answers, brainstorming, conversational Q&A",
      "_note": "GLM-4.7-Flash is FREE (Z.ai). 203K context. Primary entry point.",
      "model": "http://localhost:4000/v1||glm-4.7-flash||sk-litellm-master",
      "temperature": 0.5,
      "maxTokens": 4096,
      "system_prompt_append": "\n\n<role>Answer quickly and concisely. When uncertain, say so. For code, prefer runnable examples over pseudocode.</role>",
      "fallback_models": [
        "http://localhost:4000/v1||glm-4.5-flash||sk-litellm-master",
        "http://localhost:4000/v1||gpt-4.1-nano||sk-litellm-master",
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
      ],
    },

    // ── UI / MULTIMODAL REVIEWER ──────────────────────────────────────────────
    // Gemini 3 Pro Preview: multimodal vision for screenshots/mockups.
    // Differentiated from oracle: this agent requires image input; oracle is code-only.
    "visionary": {
      "_role": "UI/UX REVIEWER — multimodal design review (requires screenshot/mockup input)",
      "_note": "Use when you have image input. For code-only review, use oracle.",
      "model": "cursor-acp/gemini-3-pro-preview",
      "temperature": 0.2,
      "maxTokens": 8192,
      "system_prompt_append": "\n\n<role>UI/UX reviewer with vision. Concretely address: (1) layout and pixel alignment, (2) accessibility (contrast ratios, tap targets ≥44px), (3) Tamagui/Expo patterns for Playspace mobile, (4) responsive phone vs tablet. Rate: CRITICAL / MAJOR / MINOR / NIT.</role>\n\n<skills>.agents/ui-ux/ui-ux-pro-max.md + .agents/ui-ux/mobile-design.md + .agents/sdks/tamagui.md + .agents/ui-ux/web-design-guidelines.md</skills>",
      "fallback_models": [
        "http://localhost:4000/v1||gemini-3.1-pro||sk-litellm-master",
        "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
        "http://localhost:4000/v1||kimi-k2.5||sk-litellm-master",
        "http://localhost:4000/v1||gemini-2.5-pro||sk-litellm-master",
      ],
    },

    // ── DATA / INFRA ──────────────────────────────────────────────────────────
    "architect": {
      "_role": "DATA/INFRA — database schema, SQLAlchemy/Alembic, query optimization, backend",
      "model": "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
      "temperature": 0.15,
      "maxTokens": 12000,
      "system_prompt_append": "\n\n<role>Data and infrastructure specialist. Schema design: explicit FKs, soft deletes, multilingual text, audit timestamps. SQLAlchemy: multi-model pattern (Base/Create/Update/Response/InDB). Consider offline-sync for Playspace mobile. JobOS: Celery task design, RDS connection pooling, Redis cache strategy.</role>\n\n<skills>.agents/sdks/sqlalchemy.md + .agents/architecture/backend-architect.md + .agents/sdks/fastapi.md</skills>",
      "fallback_models": [
        "http://localhost:4000/v1||deepseek-v4||sk-litellm-master",
        "http://localhost:4000/v1||deepseek-r1||sk-litellm-master",
        "http://localhost:4000/v1||gemini-3.1-pro||sk-litellm-master",
        "http://localhost:4000/v1||o4-mini||sk-litellm-master",
      ],
    },
  },

  "categories": {
    "quick": {
      "_note": "FREE: GLM-4.7-Flash (Z.ai)",
      "model": "http://localhost:4000/v1||glm-4.7-flash||sk-litellm-master",
    },

    "boilerplate": {
      "_note": "gpt-4.1-nano $0.10/M — backed by $2,500 YC OpenAI credits",
      "model": "http://localhost:4000/v1||gpt-4.1-nano||sk-litellm-master",
      "fallback": "http://localhost:4000/v1||glm-4.7-flash||sk-litellm-master",
    },

    "coding": {
      "_note": "grok-4.1-fast $0.20/$0.50, 2M ctx — primary headless coder",
      "model": "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
      "fallback": "http://localhost:4000/v1||gemini-3-flash||sk-litellm-master",
      "system_prompt_append": "\n\n<skills>TypeScript: .agents/language/typescript.md. Stack-specific skills as needed.</skills>",
    },

    "ui-engineering": {
      "_note": "grok-4.1-fast (2M ctx) → Gemini 3 Flash (quota) for mobile UI",
      "model": "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
      "fallback": "http://localhost:4000/v1||gemini-3-flash||sk-litellm-master",
      "system_prompt_append": "\n\n<skills>.agents/ui-ux/mobile-design.md + .agents/sdks/tamagui.md + .agents/sdks/expo.md + .agents/ui-ux/ui-ux-pro-max.md</skills>",
    },

    "web-engineering": {
      "_note": "Gemini 3 Flash (quota) → Grok 4.1 Fast for Next.js/TanStack work",
      "model": "http://localhost:4000/v1||gemini-3-flash||sk-litellm-master",
      "fallback": "http://localhost:4000/v1||grok-4.1-fast||sk-litellm-master",
      "system_prompt_append": "\n\n<skills>.agents/ui-ux/web-design-guidelines.md + .agents/sdks/shadcn.md + .agents/sdks/tanstack.md + .agents/language/typescript.md</skills>",
    },

    "reasoning": {
      "_note": "R1 $0.55/$2.19 → Grok 3 Mini $0.30/$0.50 → o4-mini $1.10/$4.40",
      "model": "http://localhost:4000/v1||deepseek-r1||sk-litellm-master",
      "fallback": "http://localhost:4000/v1||grok-3-mini||sk-litellm-master",
    },

    "deep-reasoning": {
      "_note": "o4-mini $1.10/$4.40 backed by YC OpenAI credits. o3 only when necessary.",
